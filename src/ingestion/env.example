# Copy this file to .env and fill in real values.
# .env is gitignored - never commit it. Riot dev keys expire every 24h,
# so you'll be updating RIOT_API_KEY here often during active development.

RIOT_API_KEY=your_dev_api_key_here
RIOT_GAME_NAME=your_game_name
RIOT_TAG_LINE=your_tag_line
RIOT_REGION=ap
